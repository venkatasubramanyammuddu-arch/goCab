# Copy this file to .env and set your own values. Never commit .env.
#
# docker-compose.yml reads these three and builds DATABASE_URL for the app:
#   postgresql://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB
# ("db" is the Compose service name; inside Docker it replaces "localhost".)

# Name of the database user PostgreSQL creates on first start
POSTGRES_USER=cab
# Password for that user. Choose your own. Avoid characters like @ : / % that need URL encoding.
POSTGRES_PASSWORD=change-me
# Name of the database PostgreSQL creates on first start
POSTGRES_DB=cabapp

# Note: these only take effect when the database volume is first created.
# Changing the password later does not change an existing database; to start over run
#   docker compose down -v
# (this deletes all database data).
